# Required: choose any provider and model supported by the bundled Pi CLI.
PI_CHAT_PROVIDER=zai
PI_CHAT_MODEL=glm-5.1

# Use this for providers that accept one API key.
PI_CHAT_API_KEY=

# Providers with native multi-variable credentials can add their Pi-supported
# variables here instead, for example AWS_PROFILE or AZURE_OPENAI_API_KEY.

# Optional loopback host port. The container always listens on port 5173.
EMOTION_ORBIT_PORT=5173
